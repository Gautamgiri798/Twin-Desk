;
; DualDesk Virtual Indirect Display Driver INF
;

[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=DualDeskDisplay.cat
DriverVer=10/20/2026,1.0.0.1
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
UMDriverCopy = 12\UMDF

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
DualDeskIddDriver.dll = 1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=DualDesk_Install, Root\DualDeskDisplay

[DualDesk_Install.NT]
CopyFiles=UMDriverCopy

[DualDesk_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFService_Install

[DualDesk_Install.NT.Wdf]
UmdfService=DualDeskIddDriver,DualDesk_Install_Umdf
UmdfServiceOrder=DualDeskIddDriver

[DualDesk_Install_Umdf]
UmdfLibraryVersion=2.25
ServiceBinary=%12%\UMDF\DualDeskIddDriver.dll

[WUDFService_Install]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

[UMDriverCopy]
DualDeskIddDriver.dll

[Strings]
ManufacturerName="DualDesk Project"
DiskName="DualDesk Virtual Display Installation Disk"
DeviceName="DualDesk Virtual Extended Display Adapter"
